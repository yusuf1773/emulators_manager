{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "debug",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "core",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"EMU_BUILD_CLI": "OFF",
				"EMU_BUILD_PERSISTENCE": "OFF"
			}
		},
		{
			"name": "ci-linux",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "ci-windows",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
		{"name": "debug", "configurePreset": "debug"},
		{"name": "core", "configurePreset": "core"},
		{"name": "ci-linux", "configurePreset": "ci-linux"},
		{"name": "ci-windows", "configurePreset": "ci-windows"}
	],
	"testPresets": [
		{
			"name": "debug",
			"configurePreset": "debug",
			"output": {"outputOnFailure": true}
		},
		{
			"name": "core",
			"configurePreset": "core",
			"output": {"outputOnFailure": true}
		},
		{
			"name": "ci-linux",
			"configurePreset": "ci-linux",
			"output": {"outputOnFailure": true}
		},
		{
			"name": "ci-windows",
			"configurePreset": "ci-windows",
			"output": {"outputOnFailure": true}
		}
	]
}
